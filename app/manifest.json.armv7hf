{
    "schemaVersion": "1.7.0",
    "resources": {
        "dbus": {
            "requiredMethods": [
                "com.axis.Graphics2.*",
                "com.axis.Overlay2.*"
            ]
        }
    },
    "acapPackageConf": {
        "setup": {
            "appName": "aurix",
            "friendlyName": "AURIX Face Match (benchmark)",
            "vendor": "AURIX",
            "embeddedSdkVersion": "3.0",
            "vendorUrl": "https://cassise.com",
            "runMode": "respawn",
            "version": "0.3.0"
        },
        "configuration": {
            "paramConfig": [
                {
                    "name": "Gallery",
                    "default": "",
                    "type": "string"
                },
                {
                    "name": "MatchThreshold",
                    "default": "45",
                    "type": "int:maxlen=3;min=0;max=100"
                },
                {
                    "name": "Overlay",
                    "default": "yes",
                    "type": "bool:no,yes"
                }
            ]
        }
    }
}
