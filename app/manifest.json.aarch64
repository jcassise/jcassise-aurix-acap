{
    "schemaVersion": "2.2.0",
    "resources": {
        "linux": {
            "user": {
                "groups": [
                    "video"
                ]
            }
        },
        "deepLearningProcessor": {
            "enabled": true,
            "required": true
        },
        "dbus": {
            "requiredMethods": [
                "com.axis.Graphics2.*",
                "com.axis.Overlay2.*"
            ]
        }
    },
    "acapPackageConf": {
        "setup": {
            "appName": "aurix",
            "friendlyName": "AURIX Face Match (benchmark)",
            "vendor": "AURIX",
            "vendorId": "1234567890",
            "vendorUrl": "https://cassise.com",
            "runMode": "respawn",
            "version": "0.4.0",
            "compatibleOsVersions": [
                {
                    "max": "13"
                }
            ]
        },
        "configuration": {
            "paramConfig": [
                {
                    "name": "Gallery",
                    "default": "",
                    "type": "string"
                },
                {
                    "name": "MatchThreshold",
                    "default": "45",
                    "type": "int:maxlen=3;min=0;max=100"
                },
                {
                    "name": "Overlay",
                    "default": "yes",
                    "type": "bool:no,yes"
                },
                {
                    "name": "PharosUrl",
                    "default": "",
                    "type": "string"
                },
                {
                    "name": "PharosDeviceId",
                    "default": "",
                    "type": "string"
                },
                {
                    "name": "PharosToken",
                    "default": "",
                    "type": "string"
                },
                {
                    "name": "PharosServerCert",
                    "default": "",
                    "type": "string"
                },
                {
                    "name": "PharosStatus",
                    "default": "Not commissioned",
                    "type": "string"
                }
            ]
        }
    }
}
